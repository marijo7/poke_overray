__pycache__/
*.pyc
.venv/
# 個人設定 (OBS のパスワード等を含む)
config.json
# 採用率データは tools/update_usage.py で各自取得する
data/usage.json
# ポケモン画像のキャッシュ (初回表示時に取得)
data/sprites/
# 登録した選出画面アイコン (各自の環境で学習)
data/icons/
# 対戦中の顔画像 (メガシンカ判定用に各自の環境で学習)
data/portraits/
web/fonts/*
!web/fonts/README.txt
# 登録したニックネーム
data/nicknames.json
# 選出画面のタイプアイコン (各自の環境で学習)
# 選出画面の照合用に取得する Champions のポケモン画像
data/champions_icons/
# 選出画面のマーカーの画像 (各自の環境で学習)
data/markers/
data/fit/user_*
